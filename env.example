# =============================================================================
# CBSE Learning Companion - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend-accessible Supabase variables
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Rork AI Toolkit Configuration (Required)
# -----------------------------------------------------------------------------
# This is automatically configured by Rork platform
# If self-hosting, you'll need to set up your own AI service endpoint
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# Automatically set by Rork when using --tunnel flag
# For production, set this to your deployed backend URL
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-backend-domain.com

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, production
NODE_ENV=production
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Storage Configuration (Optional)
# -----------------------------------------------------------------------------
# If using custom storage bucket for uploads
SUPABASE_STORAGE_BUCKET=uploads

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Add your analytics keys here if using third-party services
# SENTRY_DSN=your-sentry-dsn
# AMPLITUDE_API_KEY=your-amplitude-key

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
ENABLE_ADMIN_ANALYTICS=true
ENABLE_DIAGNOSTICS=true
ENABLE_GAMIFICATION=true
ENABLE_REWARDS=true
ENABLE_TEXTBOOK_HELP=true
